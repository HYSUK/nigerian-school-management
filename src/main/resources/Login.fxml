<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="350.0" spacing="15.0" style="-fx-background-color: #1e3d59;" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.nigeriaschools.controller.LoginController">
   <children>
      <Label text="SCHOOL PORTAL ENGINE" textFill="WHITE">
         <font><Font name="System Bold" size="20.0" /></font>
      </Label>
      <Label text="Teacher &amp; Staff Authentication Panel" textFill="#e8e8e8">
         <font><Font size="13.0" /></font>
         <VBox.margin><Insets bottom="20.0" /></VBox.margin>
      </Label>
      
      <VBox alignment="CENTER_LEFT" maxWidth="280.0" spacing="5.0">
         <children>
            <Label text="Username/Portal ID" textFill="WHITE" />
            <TextField fx:id="usernameField" prefHeight="35.0" promptText="Enter your portal ID" style="-fx-background-radius: 4;" />
         </children>
      </VBox>
      
      <VBox alignment="CENTER_LEFT" maxWidth="280.0" spacing="5.0">
         <children>
            <Label text="Security Password" textFill="WHITE" />
            <PasswordField fx:id="passwordField" prefHeight="35.0" promptText="••••••••••••" style="-fx-background-radius: 4;" />
         </children>
      </VBox>
      
      <Button fx:id="loginButton" mnemonicParsing="false" onAction="#handleLogin" prefHeight="40.0" prefWidth="280.0" style="-fx-background-color: #17b978; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="SECURE LOGIN">
         <VBox.margin><Insets top="15.0" /></VBox.margin>
      </Button>
      
      <Label fx:id="errorLabel" textFill="#ff6b6b" wrapText="true">
         <font><Font name="System Bold" size="12.0" /></font>
      </Label>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
