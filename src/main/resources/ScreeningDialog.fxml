<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.nigeriaschools.controller.ScreeningDialogController"
      style="-fx-background-color: #ffffff; -fx-padding: 20;">

    <Label text="Assign Screening Exercise Result" style="-fx-font-weight: bold; -fx-text-fill: #1a237e;">
        <font><Font size="16.0" /></font>
    </Label>

    <Separator />

    <Label fx:id="studentInfoLabel" text="Student: Loading..." style="-fx-font-weight: bold; -fx-text-fill: #333;" />

    <GridPane vgap="10.0" hgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="100.0" />
            <ColumnConstraints prefWidth="180.0" />
        </columnConstraints>
        
        <children>
            <Label text="Exam Score (%):" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="scoreField" promptText="e.g. 68" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Cut-off Mark (%):" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <TextField fx:id="cutoffField" promptText="e.g. 50" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        </children>
    </GridPane>

    <Label fx:id="statusLabel" text="" wrapText="true" />

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="saveButton" text="Save &amp; Sync to Cloud" onAction="#handleSaveAndSync" 
                style="-fx-background-color: #17b978; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
    </HBox>
</VBox>