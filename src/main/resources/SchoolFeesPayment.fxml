<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: #F8F9FA;" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.nigeriaschools.controller.SchoolFeesPaymentController">
   
   <!-- TOP PANEL: Invoicing Filters & Global Control Bar -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);" BorderPane.alignment="CENTER">
         <children>
            <Label text="Bursary Ledger Panel" textFill="#1A365D">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </Label>
            
            <ComboBox fx:id="classComboBox" prefWidth="120.0" promptText="Select Class" style="-fx-background-radius: 4;" />
            <ComboBox fx:id="sessionComboBox" prefWidth="150.0" promptText="Academic Year" style="-fx-background-radius: 4;" />
            <ComboBox fx:id="termComboBox" prefWidth="120.0" promptText="Term" style="-fx-background-radius: 4;" />
            
            <Button fx:id="loadLedgerButton" mnemonicParsing="false" onAction="#handleLoadLedger" style="-fx-background-color: #1A365D; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Load Ledger Row" />
         </children>
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </HBox>
   </top>

   <!-- CENTER PANEL: Interactive Financial Spreadsheet Container -->
   <center>
      <StackPane BorderPane.alignment="CENTER">
         <children>
            <TableView fx:id="feesTableView" prefHeight="200.0" prefWidth="200.0" style="-fx-background-radius: 6; -fx-border-color: #E2E8F0; -fx-border-radius: 6;">
              <columns>
                <TableColumn fx:id="regNoColumn" editable="false" prefWidth="140.0" text="Student Reg No" />
                <TableColumn fx:id="amountDueColumn" editable="false" prefWidth="120.0" text="Amount Due (₦)" />
                <TableColumn fx:id="amountPaidColumn" prefWidth="130.0" text="Amount Paid (₦)" />
                <TableColumn fx:id="balanceColumn" editable="false" prefWidth="120.0" text="Outstanding Bal (₦)" />
                <TableColumn fx:id="statusColumn" editable="false" prefWidth="120.0" text="Payment Status" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            
            <!-- Safe Execution Loading Thread Anchor -->
            <ProgressIndicator fx:id="progressIndicator" maxHeight="60.0" maxWidth="60.0" style="-fx-progress-color: #3182CE;" visible="false" />
         </children>
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </StackPane>
   </center>

     <!-- BOTTOM PANEL: Batch Financial Synchronization Bar -->
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0;" BorderPane.alignment="CENTER">
         <children>
            <Label text="* Double-click on 'Amount Paid' column cells to input payment directly." textFill="#718096">
               <font><Font name="System Italic" size="12.0" /></font>
               <HBox.margin><Insets right="10.0" /></HBox.margin>
            </Label>
            
            <!-- 🌟 NEW: THE RECEIPT VOUCHER STANDALONE EXPORT ACTION BUTTON ANCHOR -->
            <Button mnemonicParsing="false" onAction="#handlePrintReceipt" style="-fx-background-color: #3182CE; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 15 8 15; -fx-background-radius: 4;" text="🖨️ Print Selected Receipt" />
            
            <Button fx:id="syncChangesButton" mnemonicParsing="false" onAction="#handleSaveChanges" style="-fx-background-color: #38A169; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 8 20 8 20; -fx-background-radius: 4;" text="Sync &amp; Save Financial Changes" />
         </children>
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
